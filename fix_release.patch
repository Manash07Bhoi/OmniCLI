      - name: Validate artifacts and generate checksums
        run: |
          cd release_assets
          
          echo "Validating downloaded artifact tree:"
          ls -R
          
          # Ensure no subdirectories exist. Fail action if they do.
          DIR_COUNT=$(find . -mindepth 1 -type d | wc -l)
          if [ "$DIR_COUNT" -gt 0 ]; then
            echo "Error: Unexpected subdirectories found in release_assets/."
            test 0 -eq 1
          fi
          
          # Ensure we have expected files
          FILE_COUNT=$(find . -maxdepth 1 -type f -name 'omnicli-*' | wc -l)
          if [ "$FILE_COUNT" -lt 1 ]; then
            echo "Error: No omnicli release artifacts found in release_assets/."
            test 0 -eq 1
          fi
          
          # Ensure no empty files
          EMPTY_COUNT=$(find . -maxdepth 1 -type f -name 'omnicli-*' -empty | wc -l)
          if [ "$EMPTY_COUNT" -gt 0 ]; then
            echo "Error: Empty artifact found in release_assets/."
            test 0 -eq 1
          fi
          
          echo "Generating checksums for exactly the release artifacts..."
          find . -maxdepth 1 -type f -name 'omnicli-*' -exec sha256sum {} + > SHA256SUMS.txt
          
          # Strip leading './'
          sed -i 's| \./| |g' SHA256SUMS.txt
          
          cat SHA256SUMS.txt

