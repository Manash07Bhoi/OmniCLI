      - name: Validate artifacts and generate checksums
        run: |
          cd dist
          
          echo "Initial dist/ structure:"
          ls -R
          
          # Safe flattening:
          # Find all regular files in any subdirectory (mindepth 2)
          # Use -execdir cp to safely copy them to the current working directory (.)
          # The -n flag prevents overwriting if a collision somehow happens
          find . -mindepth 2 -type f -execdir cp -n {} "$PWD" \;
          
          echo "Generating checksums for exactly the release artifacts..."
          # Hash all files starting with omnicli-
          sha256sum omnicli-* > SHA256SUMS.txt
          
