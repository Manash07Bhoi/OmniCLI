{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "prettier": "^3.9.5",
    "typescript": "~5.9.3"
  },
  "pnpm": {
    "overrides": {
      "baseline-browser-mapping@<2.11.27": "2.11.27",
      "browserslist@<4.28.7": "4.28.7",
      "esbuild@<0.25.0": "0.25.8",
      "fast-copy@<4.1.2": "4.1.2",
      "fast-uri@<3.1.8": "3.1.8",
      "nanoid@<3.3.20": "3.3.20",
      "postcss-selector-parser@<7.1.6": "7.1.6",
      "postcss@<8.5.29": "8.5.29",
      "proxy-addr@<2.0.8": "2.0.8",
      "qs@<6.16.0": "6.16.0",
      "source-map-js@<1.2.2": "1.2.2"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "esbuild-plugin-pino>esbuild": "0.28"
      }
    }
  }
}
